load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "golden",
    testonly = True,
    srcs = ["golden.rs"],
    crate_name = "mutask_golden",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//third_party:difflib",
    ],
)

rust_binary(
    name = "driver",
    testonly = True,
    srcs = ["driver.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":golden",
        "@crates_mutask//:argh",
    ],
)

rust_test(
    name = "golden_test",
    compile_data = glob(["testdata/**"]),
    crate = ":golden",
    edition = "2024",
)

rust_test(
    name = "driver_test",
    crate = ":driver",
    edition = "2024",
)
