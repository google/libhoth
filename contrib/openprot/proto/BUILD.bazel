load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//rust:defs.bzl", "rust_proto_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//contrib/tlv:rules.bzl", "tlv_codegen")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "crypto_proto",
    srcs = ["crypto.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "//contrib/tlv:options_proto",
    ],
)

rust_proto_library(
    name = "crypto_rust_proto",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [":crypto_proto"],
)

tlv_codegen(
    name = "crypto_tlv",
    src = "crypto_tlv.rs",
    proto = ":crypto_proto",
    visibility = ["//visibility:public"],
)

proto_library(
    name = "identity_proto",
    srcs = ["identity.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "//contrib/tlv:options_proto",
    ],
)

rust_proto_library(
    name = "identity_rust_proto",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [":identity_proto"],
)

tlv_codegen(
    name = "identity_tlv",
    src = "identity_tlv.rs",
    proto = ":identity_proto",
    visibility = ["//visibility:public"],
)

proto_library(
    name = "key_rotation_proto",
    srcs = ["key_rotation.proto"],
    visibility = ["//visibility:public"],
    deps = [
        ":crypto_proto",
        ":identity_proto",
        "//contrib/tlv:options_proto",
    ],
)

rust_proto_library(
    name = "key_rotation_rust_proto",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [":key_rotation_proto"],
)

tlv_codegen(
    name = "key_rotation_tlv",
    src = "key_rotation_tlv.rs",
    proto = ":key_rotation_proto",
    visibility = ["//visibility:public"],
    deps = [
        ":crypto_tlv",
        ":identity_tlv",
    ],
)

rust_library(
    name = "proto",
    srcs = [
        "lib.rs",
    ],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":crypto_tlv",
        ":identity_tlv",
        ":key_rotation_tlv",
        "//contrib/tlv",
        "//third_party:zerocopy",
    ],
)

rust_test(
    name = "proto_test",
    crate = ":proto",
    deps = [
        ":crypto_rust_proto",
        ":identity_rust_proto",
        ":key_rotation_rust_proto",
        "//contrib/tlv:proto_conv",
        "@protobuf//rust:protobuf",
    ],
)
