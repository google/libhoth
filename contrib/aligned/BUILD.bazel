load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

rust_library(
    name = "aligned",
    srcs = [
        "lib.rs",
        "u64.rs",
    ],
    crate_features = [
        "ufmt",
    ],
    crate_name = "mutask_aligned",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//third_party:ufmt",
        "//third_party:zerocopy",
    ],
)

rust_test(
    name = "aligned_test",
    crate = ":aligned",
    edition = "2024",
)

rust_doc_test(
    name = "aligned_doctest",
    crate = ":aligned",
)
