load("@protobuf//rust:defs.bzl", "rust_proto_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "reader",
    srcs = ["reader.rs"],
    crate_name = "mutask_proto_reader",
    edition = "2024",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "reader_test",
    crate = ":reader",
    edition = "2024",
)

rust_library(
    name = "reflect",
    srcs = ["reflect.rs"],
    crate_name = "mutask_proto_reflect",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":descriptor_rust_proto",
        "@protobuf//rust:protobuf",
    ],
)

rust_proto_library(
    name = "descriptor_rust_proto",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = ["@protobuf//:descriptor_proto"],
)
