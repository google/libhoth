load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//rust:defs.bzl", "rust_proto_library")
load("//contrib/tlv:rules.bzl", "tlv_codegen")

proto_library(
    name = "soc_proto",
    srcs = ["soc.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "//contrib/tlv:options_proto",
    ],
)

rust_proto_library(
    name = "soc_rust_proto",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [":soc_proto"],
)

proto_library(
    name = "edge_cases_proto",
    srcs = ["edge_cases.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "//contrib/tlv:options_proto",
    ],
)

rust_proto_library(
    name = "edge_cases_rust_proto",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [":edge_cases_proto"],
)

proto_library(
    name = "bad_proto",
    srcs = ["bad.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "//contrib/tlv:options_proto",
    ],
)

rust_proto_library(
    name = "bad_rust_proto",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [":bad_proto"],
)

tlv_codegen(
    name = "soc_tlv",
    src = "soc_tlv.rs",
    proto = ":soc_proto",
    visibility = ["//visibility:public"],
)

tlv_codegen(
    name = "edge_cases_tlv",
    src = "edge_cases_tlv.rs",
    proto = ":edge_cases_proto",
    visibility = ["//visibility:public"],
)
