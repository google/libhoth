load("@rules_rust//rust:defs.bzl", "rust_test")

rust_test(
    name = "cli_test",
    srcs = ["cli_test.rs"],
    data = ["//tools/tlvtool"],
    edition = "2024",
    deps = ["@rules_rust//tools/runfiles"],
)

# Golden tests for the `inspect` report. Update them with:
#   UPDATE_GOLDEN=1 bazel run //tools/tlvtool/tests:inspect_test
rust_test(
    name = "inspect_test",
    srcs = ["inspect_test.rs"],
    compile_data = glob(["testdata/inspect_test/*.golden"]),
    edition = "2024",
    rustc_flags = [
        "-C",
        "link-arg=-lgcc",
    ],
    deps = [
        "//shared/golden",
        "//shared/openprot/proto:crypto_rust_proto",
        "//tools/tlvtool:tlvtool_lib",
    ],
)
